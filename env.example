# Database Configuration
DB_USER=postgres
# Required. install.sh generates a strong one; set your own if not using it.
DB_PASSWORD=
DB_NAME=attendance_db
DB_PORT=5432

# JWT Secret (Generate a random 64-character hex string)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required. The server refuses to start without it. Never reuse a value
# published anywhere (including an earlier version of this file).
JWT_SECRET=

# Encrypts credentials stored in the database (backup destinations, HRMS
# secrets). Keep it separate from JWT_SECRET; changing it makes them unreadable.
SECRETS_KEY=

# Server Configuration
SERVER_URL=http://192.168.1.237
HTTP_PORT=80
API_PORT=3001
ADMS_PORT=8080
LOG_LEVEL=info

# First administrator's temporary password. Leave blank and the server
# generates a strong one on first start and prints it; it must be changed at
# first sign-in either way.
ADMIN_PASSWORD=

